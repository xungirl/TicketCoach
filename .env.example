LLM_API_KEY=your_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Model choice (通义 DashScope). 注意：qwen3-max 已于 2026-10 下线（返回 404）。
#   qwen-plus  —— 推荐：均衡，单条 JSON 约 15s
#   qwen-max   —— 更强，稍慢
#   qwen-flash —— 最快最便宜
# 注意：深度思考模型（如 qwen3.7-max）很慢，生成长文易超时，不建议用于本应用。
LLM_MODEL=qwen-plus

# Fallback chain（主模型 404/403/限流/超时/5xx 时依次尝试）。"provider:model" 走别的厂商，
# 整个账号不可用（欠费 Arrearage / key 失效）时只有跨厂商兜底能救。
# 不写时默认 qwen-plus,qwen-flash（+ gemini:gemini-2.5-flash，若配置了 GEMINI_API_KEY）
# LLM_FALLBACK_MODELS=qwen-plus,qwen-flash,gemini:gemini-2.5-flash
# GEMINI_API_KEY=your_gemini_key
# GEMINI_MODEL=gemini-2.5-flash

# 单价（元 / 百万 token，[输入, 输出]），用于 /api/metrics 的成本估算。
# 以百炼控制台当前价格为准，不配则只统计 token 不算钱。
# LLM_PRICES={"qwen-plus": [0.8, 2.0], "gemini:gemini-2.5-flash": [0, 0]}

# 故障注入：按概率让第一个模型调用失败，验证兜底链路（只在测试时开）
# LLM_CHAOS_RATE=0.3

# Per-request timeout in seconds (强模型生成较慢，默认放宽到 180)
LLM_TIMEOUT=180

# Access password (可选): 设置后，调用生成/批量/对练/评分接口需带 X-Access-Token 头。
# 本地开发可留空（不校验）；线上部署务必设置，防止别人用你的链接消耗 token。
# ACCESS_PASSWORD=your_secret_password

# DeepSeek example (OpenAI-compatible too):
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
