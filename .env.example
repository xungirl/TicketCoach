LLM_API_KEY=your_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Model choice (通义 DashScope):
#   qwen3-max  —— 推荐：质量最强且可用（质检分更高，单条三步约 60s）
#   qwen-max   —— 强，速度接近 qwen3-max
#   qwen-plus  —— 均衡，更快更便宜
#   qwen-turbo —— 最快最便宜
# 注意：深度思考模型（如 qwen3.7-max）很慢，生成长文易超时，不建议用于本应用。
LLM_MODEL=qwen3-max

# Per-request timeout in seconds (强模型生成较慢，默认放宽到 180)
LLM_TIMEOUT=180

# DeepSeek example (OpenAI-compatible too):
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
